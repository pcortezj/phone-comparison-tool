# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# python
__pycache__/
*.py[cod]

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local phone datasets, database files, and generated dumps/backups
# (the product dataset and any production exports must never be committed)
/data/imports/*.json
!/data/imports/sample-phones.json
/data/exports/
data/**/*.csv
*.dump
*.backup
*.bak
*.sqlite
*.sqlite3
/dev.db
/dev.db-journal
/prisma/*.db
/prisma/*.db-journal

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
