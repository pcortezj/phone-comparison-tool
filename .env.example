# PostgreSQL connection strings (required)
# DATABASE_URL: used by the app at runtime and should be a pooled connection
#   string if your provider offers one (e.g. Neon/Vercel Postgres's pooled URL,
#   Supabase's "Transaction" pooler URL). Serverless platforms like Vercel run
#   many concurrent function instances, each opening its own connections, so
#   an unpooled URL here can exhaust your database's connection limit.
# DIRECT_URL: used only by Prisma Migrate/`db push` and should be the direct
#   (non-pooled) connection string. If your provider only gives you one
#   connection string, set both variables to the same value.
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database

# Comparison assistant provider selection. One of: openai, huggingface, ollama.
# If unset, the app picks openai (if OPENAI_API_KEY is set), else huggingface
# (if HF_TOKEN is set), else ollama. On Vercel, use "openai" or "huggingface" -
# "ollama" points at a local server and is not reachable in production.
COMPARE_ASSISTANT_PROVIDER=huggingface

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Set to "true" to fully skip OpenAI (even if OPENAI_API_KEY happens to be
# set) and treat it as an unconfigured provider. Useful when you don't want
# to pay for/maintain an OpenAI key and just want the free providers below.
COMPARE_ASSISTANT_DISABLE_OPENAI=false

# Hugging Face (router.huggingface.co) - required for the "huggingface" provider.
# Prefer a plain instruct model over reasoning models (DeepSeek-R1, o1-style) -
# reasoning models generate a long hidden chain-of-thought and add noticeable latency.
HF_TOKEN=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct:fastest

# Local-only fallback - do not set in production/Vercel.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Public site URL, used to build canonical/Open Graph URLs and the sitemap.
# Set this to your real production domain once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Affiliate IDs for the "Where to buy" section on individual phone pages
# (src/lib/affiliate-links.ts). Each one is appended to a retailer search-URL
# template - leave unset and the links still work, just without attribution.
AFFILIATE_AMAZON_ID=
AFFILIATE_BESTBUY_ID=
AFFILIATE_EBAY_ID=
